# ============================================================================
# SHARIK CRM — ENTERPRISE ENVIRONMENT CONFIGURATION (RC-2 PRODUCTION HARDENED)
# ============================================================================
# Copy this file to .env.local and populate all values before starting the app.
# NEVER commit .env.local or .env to version control.
# ============================================================================

# 1. Supabase Credentials (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_REF=your-project-ref

# 2. AI Platform (Sprint 7 — set SHARIK_FLAG_ENABLE_AI_PLATFORM=true to enable)
# Primary provider: Google Gemini 1.5 Flash
GEMINI_API_KEY=your-gemini-api-key-here
# Fallback provider: OpenAI GPT-4o Mini
OPENAI_API_KEY=your-openai-api-key-here
# Optional: Local LLM (Ollama etc.)
LOCAL_LLM_ENDPOINT=http://localhost:11434
# Active AI provider: gemini | openai | anthropic | azure | local
SHARIK_AI_PROVIDER=gemini

# 3. Feature Flags — server-side (set to true to enable; default all false for Sprint 7)
SHARIK_FLAG_ENABLE_AI_PLATFORM=false
SHARIK_FLAG_ENABLE_WORKFLOWS=false
SHARIK_FLAG_ENABLE_PUBLIC_API=false
SHARIK_FLAG_ENABLE_WEBHOOKS=false
SHARIK_FLAG_ENABLE_INTEGRATION_HUB=false

# 4. Security Secrets (Required for production)
# API Key HMAC salt — MUST be a random 32+ character secret
API_KEY_HASH_SALT=generate-a-secure-random-string-of-32-chars-minimum
# Enterprise License Signing Secrets
LICENSE_SIGNING_SECRET=sharik_enterprise_licensing_secret_2026
LICENSE_SIGNING_SECRET_FALLBACK=sharik_fallback_licensing_secret_2026
# Background Worker Authorization
CRON_SECRET=sharik_cron_secret_2026

# 5. Email Platform (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@yourcompany.com
# SMTP (alternative)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourcompany.com
SMTP_PASS=your-smtp-password

# 6. OAuth Providers (Configured in Supabase Auth Dashboard)
# Redirect URI: https://your-project.supabase.co/auth/v1/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AZURE_CLIENT_ID=your-microsoft-azure-client-id
AZURE_CLIENT_SECRET=your-microsoft-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# 7. Payment Providers
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
WISE_API_KEY=your-wise-api-key
PADDLE_VENDOR_ID=your-paddle-vendor-id
PADDLE_API_KEY=your-paddle-api-key
LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key

# 8. WhatsApp Business Cloud API
WHATSAPP_CLOUD_API_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=sharik_wa_verify_token_2026

# 9. Google Places API (Reviews)
GOOGLE_PLACES_API_KEY=your-google-places-api-key
